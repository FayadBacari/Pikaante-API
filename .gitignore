bin/
obj/
/packages/
riderModule.iml
/_ReSharper.Caches/

# Base de données SQLite : elle se recrée avec "dotnet ef database update"
*.db
*.db-shm
*.db-wal

# Images envoyées par les utilisateurs : jamais sur GitHub.
# Le fichier vide .gitkeep est gardé, pour que le dossier existe chez un autre développeur.
**/wwwroot/images/*
!**/wwwroot/images/.gitkeep
